# Database Configuration
DATABASE_URL="your_postgres_connection_string_here"
POSTGRES_URL="your_postgres_connection_string_here"
PRISMA_DATABASE_URL="your_prisma_accelerate_url_here"

# Upstash Redis (Required for rate limiting)
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL="your_upstash_redis_rest_url_here"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Cron Job Authentication
# Generate a random secret for cron job authentication
# Example: openssl rand -base64 32
CRON_SECRET="your_random_secret_here"

# CSRF Protection (Required)
# Generate a random secret for CSRF token validation
# Example: openssl rand -base64 32
CSRF_SECRET="your_random_csrf_secret_here"

# Vercel (Optional - only needed for deployment)
VERCEL_OIDC_TOKEN="your_vercel_token_here"

# Google AdSense (Optional - for monetization)
# Get your Publisher ID from https://www.google.com/adsense/
# Format: only numbers (e.g., 1234567890123456)
NEXT_PUBLIC_ADSENSE_ID="your_adsense_publisher_id_here"

# Site URL (Optional - for production CORS restrictions)
# Set this to your production domain to restrict API access
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
