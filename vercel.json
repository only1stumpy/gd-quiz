{
  "installCommand": "bun install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gd-quiz.vercel.app"
        }
      ],
      "destination": "https://gdquiz.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}